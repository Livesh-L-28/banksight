# BankSight Environment Configuration

# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=banksight-enterprise-secret-key-change-in-prod
PORT=8501
HOST=0.0.0.0

# Database
# For SQLite local fallback:
DATABASE_URL=sqlite:///backend/database/banksight.db
# For PostgreSQL (Docker / Production / CI):
# DATABASE_URL=postgresql://banksight_user:banksight_password@localhost:5432/banksight_db

# Security & Limits
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=csv,xlsx,xls
CSRF_PROTECTION=true

# Analytics & ML
DEFAULT_MODEL=gradient_boosting
CHURN_PROBABILITY_THRESHOLD_HIGH=0.65
CHURN_PROBABILITY_THRESHOLD_MEDIUM=0.35
RANDOM_STATE=42

# Power BI Export Path
POWERBI_EXPORT_DIR=data/exports/powerbi

